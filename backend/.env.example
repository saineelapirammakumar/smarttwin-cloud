# Copy this file to ".env" (same folder) and replace CHANGE_ME with YOUR OWN password. NEVER commit ".env" to Git.
# DATABASE_URL format: postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# If the password has special characters (@ : / # %), URL-encode them (for example @ becomes %40).
DATABASE_URL=postgresql+psycopg://smarttwin_user:CHANGE_ME@localhost:5432/smarttwin
# Separate database used ONLY by automated tests (its name must contain "test"). Tests wipe it.
TEST_DATABASE_URL=postgresql+psycopg://smarttwin_user:CHANGE_ME@localhost:5432/smarttwin_test
ENVIRONMENT=development
# Browser origins allowed to call the API (comma-separated). Add your Vite port if it is not 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Alerts and simulator (optional; these are the defaults)
ALERT_COOLDOWN_SECONDS=300
SIMULATOR_INTERVAL_SECONDS=60
SIMULATOR_RETENTION_DAYS=7
SIM_TIMEZONE=Asia/Kolkata

# Only used by docker-compose.yml (Docker option). Use the same user/password/database as DATABASE_URL.
POSTGRES_USER=smarttwin_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=smarttwin
